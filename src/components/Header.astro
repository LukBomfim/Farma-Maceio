---
import { site, telLink, waLink } from '../config/site';
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.name} - página inicial`}>
      <img
        src="/logo.webp"
        alt={`Logotipo da ${site.name}`}
        width="96"
        height="96"
        class="h-12 w-12 sm:h-14 sm:w-14"
      />
      <span class="hidden text-lg font-bold text-pharmacy-blue sm:inline">
        {site.name}
      </span>
    </a>

    <div class="flex items-center gap-4">
      <a
        href={telLink}
        class="hidden text-sm font-medium text-pharmacy-dark hover:text-pharmacy-blue sm:inline"
      >
        {site.landlineDisplay}
      </a>

      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg bg-pharmacy-red px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-pharmacy-red-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pharmacy-blue"
      >
        Falar no WhatsApp
      </a>
    </div>
  </div>
</header>