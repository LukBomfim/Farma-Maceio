---
import { site } from '../config/site';

const icons: Record<string, string> = {
  truck:
    '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>',
  droplet:
    '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>',
  'heart-pulse':
    '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>',
};
---

<section id="servicos" class="scroll-mt-20 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <h2 class="text-center text-2xl font-bold text-pharmacy-blue sm:text-3xl">
      Nossos Serviços
    </h2>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        site.services.map((service) => (
          <article class="rounded-xl border border-slate-200 bg-pharmacy-light p-6 text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-pharmacy-blue text-white">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[service.icon]}
              />
            </div>
            <h3 class="mt-4 text-lg font-semibold text-pharmacy-dark">{service.title}</h3>
            <p class="mt-2 text-slate-700">{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>