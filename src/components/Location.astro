---
// src/components/Location.astro
import { site, mapsLink, telLink, waLink, mailLink } from '../config/site';
---

<section id="localizacao" class="scroll-mt-20 bg-pharmacy-light">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <h2 class="text-center text-2xl font-bold text-pharmacy-blue sm:text-3xl">
      Onde Estamos
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <!-- Endereço -->
      <article class="rounded-xl border border-slate-200 bg-white p-6">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-pharmacy-blue text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-pharmacy-dark">Endereço</h3>
        </div>

        <address class="mt-4 not-italic text-slate-700">
          {site.addressDetails.street}<br />
          {site.addressDetails.neighborhood}, {site.addressDetails.city} - {site.addressDetails.state}<br />
          CEP {site.addressDetails.postalCode}
        </address>

        <a
          href={mapsLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-block rounded-lg bg-pharmacy-blue px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-pharmacy-blue-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pharmacy-red"
        >
          Como Chegar (Abrir no GPS)
        </a>
      </article>

      <!-- Horário de funcionamento -->
      <article class="rounded-xl border border-slate-200 bg-white p-6">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-pharmacy-blue text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-pharmacy-dark">Horário de Funcionamento</h3>
        </div>

        <dl class="mt-4 space-y-2 text-slate-700">
          {
            site.hours.map((h) => (
              <div class="flex justify-between gap-4 border-b border-slate-100 pb-2 last:border-0">
                <dt class="font-medium">{h.label}</dt>
                <dd>{h.value}</dd>
              </div>
            ))
          }
        </dl>
      </article>

      <!-- Contato -->
      <article class="rounded-xl border border-slate-200 bg-white p-6 md:col-span-2">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-pharmacy-blue text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-pharmacy-dark">Fale com a gente</h3>
        </div>

        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Telefone -->
          <a
            href={telLink}
            class="flex items-center justify-center gap-2 rounded-lg border-2 border-pharmacy-blue px-4 py-3 text-base font-semibold text-pharmacy-blue transition-colors hover:bg-pharmacy-blue hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pharmacy-blue"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>{site.landlineDisplay}</span>
          </a>

          <!-- WhatsApp -->
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-lg bg-whatsapp px-4 py-3 text-base font-semibold text-white transition-colors hover:bg-whatsapp-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pharmacy-blue"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <span>{site.phoneDisplay}</span>
          </a>

          <!-- Instagram -->
          <a
            href={site.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-lg bg-[#c13584] px-4 py-3 text-base font-semibold text-white transition-colors hover:bg-[#a52a6e] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pharmacy-blue"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
            <span>{site.instagramHandle}</span>
          </a>

          <!-- E-mail -->
          <a
            href={mailLink}
            class="flex items-center justify-center gap-2 rounded-lg bg-pharmacy-blue px-4 py-3 text-base font-semibold text-white transition-colors hover:bg-pharmacy-blue-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pharmacy-red"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span class="break-all">{site.email}</span>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>