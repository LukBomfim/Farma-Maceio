---
import { site, mapsLink, telLink, waLink } from '../config/site';
---

<section id="localizacao" class="scroll-mt-20 bg-pharmacy-light">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <h2 class="text-center text-2xl font-bold text-pharmacy-blue sm:text-3xl">
      Onde Estamos
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <article class="rounded-xl border border-slate-200 bg-white p-6">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-pharmacy-blue text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-pharmacy-dark">Endereço</h3>
        </div>

        <address class="mt-4 not-italic text-slate-700">
          {site.addressDetails.street}<br />
          {site.addressDetails.neighborhood}, {site.addressDetails.city} - {site.addressDetails.state}<br />
          CEP {site.addressDetails.postalCode}
        </address>

        <a
          href={mapsLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-block rounded-lg bg-pharmacy-blue px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-pharmacy-blue-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pharmacy-red"
        >
          Como Chegar
        </a>
      </article>

      <article class="rounded-xl border border-slate-200 bg-white p-6">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-pharmacy-blue text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-pharmacy-dark">Horário de Funcionamento</h3>
        </div>

        <dl class="mt-4 space-y-2 text-slate-700">
          {
            site.hours.map((h) => (
              <div class="flex justify-between gap-4 border-b border-slate-100 pb-2 last:border-0">
                <dt class="font-medium">{h.label}</dt>
                <dd>{h.value}</dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-4 text-slate-700">
          Telefone:
          <a href={telLink} class="font-medium text-pharmacy-blue hover:underline">
            {site.landlineDisplay}
          </a>
          <br />
          WhatsApp:
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-pharmacy-blue hover:underline"
          >
            {site.phoneDisplay}
          </a>
        </p>
      </article>
    </div>
  </div>
</section>